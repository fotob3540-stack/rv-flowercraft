PERTANYAAN UMUM:
SkyBot tetap boleh membantu pertanyaan di luar RV FLOWERCRAFT selama dapat memberikan jawaban yang masuk akal dan akurat.

KETIKA TIDAK YAKIN:
Jangan mengarang.
Katakan bahwa informasi tersebut belum dapat dipastikan dan jelaskan apa yang perlu diketahui untuk menjawabnya.
"""

class Handler(SimpleHTTPRequestHandler):

    def do_POST(self):
        if self.path == "/api/ai":
            self.handle_ai()
        else:
            self.send_json({"error": "Not Found"}, 404)

    def handle_ai(self):
        try:
            api_key = os.environ.get("GROQ_API_KEY")

            if not api_key:
                self.send_json({
                    "error": "GROQ_API_KEY belum terpasang."
                }, 500)
                return

            length = int(self.headers.get("Content-Length", 0))
            raw = self.rfile.read(length)
            body = json.loads(raw.decode("utf-8"))

            messages = body.get("messages", [])

            if not isinstance(messages, list) or not messages:
                self.send_json({
                    "error": "Pesan kosong."
                }, 400)
                return

            safe_messages = [
                {
                    "role": "system",
                    "content": SYSTEM_PROMPT
                }
            ]

            for msg in messages[-8:]:
                if not isinstance(msg, dict):
                    continue

                role = msg.get("role")
                content = msg.get("content")

                if role in ["user", "assistant"] and isinstance(content, str):
                    safe_messages.append({
                        "role": role,
                        "content": content[:4000]
                    })

            payload = json.dumps({
                "model": "openai/gpt-oss-20b",
                "messages": safe_messages,
                "temperature": 0.2,
                "max_tokens": 500
            })

            result = subprocess.run(
                [
                    "curl",
                    "-sS",
                    "--http1.1",
                    "https://api.groq.com/openai/v1/chat/completions",
                    "-H",
                    "Authorization: Bearer " + api_key,
                    "-H",
                    "Content-Type: application/json",
                    "-H",
                    "User-Agent: RV-FLOWERCRAFT-SkyBot/1.0",
                    "-d",
                    payload
                ],
                capture_output=True,
                text=True,
                timeout=40
            )

            if result.returncode != 0:
                print("CURL ERROR:", result.stderr)

                self.send_json({
                    "error": "Koneksi ke Groq gagal."
                }, 502)
                return

            data = json.loads(result.stdout)

            if "error" in data:
                print("GROQ ERROR:", data)

                self.send_json({
                    "error": data["error"].get(
                        "message",
                        "Groq menolak request."
                    )
                }, 502)
                return

            answer = (
                data
                .get("choices", [{}])[0]
                .get("message", {})
                .get("content", "")
            )

            if not answer:
                print("EMPTY RESPONSE:", data)

                self.send_json({
                    "error": "SkyBot tidak memberikan jawaban."
                }, 502)
                return

            print("SkyBot:", answer)

            self.send_json({
                "answer": answer.strip()
            }, 200)

        except Exception as e:
            print("SERVER ERROR:", repr(e))

            self.send_json({
                "error": "SkyBot mengalami kesalahan server."
            }, 500)

    def send_json(self, data, status=200):
        output = json.dumps(
            data,
            ensure_ascii=False
        ).encode("utf-8")

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8"
        )
        self.send_header(
            "Content-Length",
            str(len(output))
        )
        self.send_header(
            "Access-Control-Allow-Origin",
            "*"
        )
        self.end_headers()

        self.wfile.write(output)


print("==========================================")
print("🔥 RV FLOWERCRAFT — SKYBOT")
print("==========================================")
print("Server : http://127.0.0.1:8000")
print("Model  : openai/gpt-oss-20b")
print("Mode   : Critical / Context-aware")

if os.environ.get("GROQ_API_KEY"):
    print("✅ GROQ_API_KEY TERBACA")
else:
    print("❌ GROQ_API_KEY TIDAK TERBACA")

print("==========================================")

server = ThreadingHTTPServer(
    (HOST, PORT),
    Handler
)

server.serve_forever()
