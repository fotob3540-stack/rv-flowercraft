  gap:12px;
  margin-bottom:15px;
}

.game-top div{
  flex:1;
  text-align:center;
  background:#f8f8f8;
  border-radius:15px;
  padding:10px;
}

.game-top small{
  display:block;
  color:#888;
  font-size:10px;
}

.game-top strong{
  display:block;
  font-size:22px;
