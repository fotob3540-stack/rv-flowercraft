.game-start-text{
  position:absolute;
  inset:0;
  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:center;
  text-align:center;
  font-size:45px;
}

.game-start-text b{
  font-size:20px;
  color:#444;
  margin-top:8px;
}

.game-start-text small{
  font-size:13px;
  color:#777;
  margin-top:5px;
}

.game-flower{
  position:absolute;
  border:0;
  background:transparent;
  font-size:42px;
  padding:5px;
  cursor:pointer;
  user-select:none;
  -webkit-tap-highlight-color:transparent;
  animation:rvFlowerPop .18s ease;
