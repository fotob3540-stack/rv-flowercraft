@keyframes rvFlowerFloat {
  0% {
    transform: translateX(0) translateY(20px) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: .65;
  }
  50% {
    transform: translateX(55vw) translateY(-35px) rotate(160deg);
  }
  90% {
    opacity: .45;
  }
  100% {
    transform: translateX(calc(100vw + 150px)) translateY(25px) rotate(320deg);
    opacity: 0;
  }
}

