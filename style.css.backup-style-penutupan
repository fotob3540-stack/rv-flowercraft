/* ==============================
   RV FLOWERCRAFT — Main Stylesheet
   Clean, organized, mobile-first
   ============================== */

/* --- CSS Custom Properties --- */
:root {
  --bg-primary: #eef5fb;
  --bg-secondary: #f7fcff;
  --bg-glass: rgba(255, 255, 255, 0.64);
  --bg-glass-hover: rgba(255, 255, 255, 0.78);
  --text-primary: #243247;
  --text-secondary: #6b8094;
  --text-muted: #7b8d9e;
  --text-light: #9aa8b8;
  --accent-pink: #ff3f7a;
  --accent-purple: #8b3ee8;
  --accent-gradient: linear-gradient(135deg, #ff3f7a, #8b3ee8);
  --accent-green: #25d366;
  --accent-blue: #3a7bd5;
  --border-glass: rgba(255, 255, 255, 0.88);
  --border-subtle: rgba(36, 50, 71, 0.10);
  --shadow-glass: 0 18px 45px rgba(47, 68, 91, 0.12);
  --shadow-sm: 0 8px 22px rgba(47, 68, 91, 0.10);
  --shadow-md: 0 12px 35px rgba(47, 68, 91, 0.10);
  --shadow-lg: 0 25px 80px rgba(47, 68, 91, 0.45);
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 25px;
  --radius-xl: 30px;
  --radius-full: 999px;
  --font-base: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  --font-display: Georgia, serif;
  --transition-fast: 0.15s ease;
  --transition-base: 0.25s ease;
  --transition-slow: 0.5s ease;
}

/* --- Reset & Base --- */
*, *::before, *::after { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg-primary); color: var(--text-primary); font-family: var(--font-base); -webkit-font-smoothing: antialiased; }
body { min-height: 100vh; min-height: 100dvh; }
button, input, select, textarea { font: inherit; }
button { cursor: pointer; border: none; background: none; }
a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }

/* --- Background --- */
#siteBackground {
  position: fixed; inset: 0; z-index: 0; pointer-events: none;
  background-color: var(--bg-secondary);
  background-image:
    linear-gradient(rgba(98, 202, 241, 0.25) 1px, transparent 1px),
    linear-gradient(90deg, rgba(98, 202, 241, 0.25) 1px, transparent 1px);
  background-size: 50px 50px;
}
#siteBackgroundShade {
  position: fixed; inset: 0; z-index: 1; pointer-events: none;
  background: rgba(245, 250, 255, 0.42);
  backdrop-filter: blur(1px); -webkit-backdrop-filter: blur(1px);
}

/* --- Shell --- */
.shell {
  position: relative; z-index: 2;
  width: min(100%, 780px); margin: auto;
  padding: 12px 14px 110px;
}

/* --- Page Transitions --- */
.page { display: none; animation: pageIn 0.35s ease; }
.page.active { display: block; }
@keyframes pageIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}

/* ==============================
   HEADER
   ============================== */
.header {
  height: 64px;
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  position: relative; z-index: 30;
  background: rgba(255, 255, 255, 0.56);
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-md);
  backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
  padding: 7px 10px;
  margin-bottom: 16px;
}
.round-btn {
  width: 42px; height: 42px;
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.9);
  background: rgba(255, 255, 255, 0.68);
  color: #33485f;
  font-size: 20px;
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(14px);
  display: grid; place-items: center;
  transition: var(--transition-base);
}
.round-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 25px rgba(47,68,91,.15); }
.brand { display: flex; align-items: center; justify-content: center; }
.brand b { display: block; font-size: 14px; letter-spacing: 1px; font-weight: 700; color: var(--text-primary); }
.brand small { display: block; font-size: 7px; letter-spacing: 2px; color: var(--text-muted); margin-top: 1px; }
.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 6px; min-width: 0; }

/* --- Music Player --- */
.music-player {
  display: flex; align-items: center; gap: 5px;
  padding: 5px 6px 5px 8px; min-height: 44px;
  border-radius: 18px;
  border: 1px solid rgba(190, 91, 255, 0.35);
  background: rgba(33, 15, 49, 0.08);
  box-shadow: var(--shadow-sm);
  backdrop-filter: blur(14px);
}
.music-bars { width: 27px; height: 28px; display: flex; align-items: center; justify-content: center; gap: 3px; }
.music-bars i { display: block; width: 3px; height: 14px; border-radius: 5px; background: #a08cc0; transform-origin: center; }
.music-bars i:nth-child(2) { height: 21px; }
.music-bars i:nth-child(3) { height: 12px; }
.music-bars i:nth-child(4) { height: 19px; }
.music-bars i:nth-child(5) { height: 9px; }
.music-player.playing .music-bars i { animation: musicPulse 0.8s ease-in-out infinite alternate; }
.music-player.playing .music-bars i:nth-child(2) { animation-delay: 0.12s; }
.music-player.playing .music-bars i:nth-child(3) { animation-delay: 0.24s; }
.music-player.playing .music-bars i:nth-child(4) { animation-delay: 0.36s; }
.music-player.playing .music-bars i:nth-child(5) { animation-delay: 0.48s; }
@keyframes musicPulse { from { transform: scaleY(0.55); opacity: 0.65; } to { transform: scaleY(1.15); opacity: 1; } }
.music-btn {
  width: 34px; height: 34px;
  border: 1px solid rgba(255, 255, 255, 0.95);
  border-radius: 11px;
  background: linear-gradient(135deg, #ff315f, #7b2ed0);
  color: #fff; display: grid; place-items: center;
  font-size: 14px; line-height: 1;
  transition: var(--transition-base); padding: 0;
}
.music-btn:last-child { font-size: 11px; }
.music-btn:hover { transform: translateY(-1px); }
.music-btn:active { transform: scale(0.94); }

/* ==============================
   BOTTOM NAVIGATION
   ============================== */
.bottom {
  position: fixed; z-index: 20;
  left: 50%; bottom: 12px; transform: translateX(-50%);
  width: min(calc(100% - 22px), 680px);
  padding: 6px;
  display: flex; flex-direction: row; flex-wrap: nowrap;
  background: rgba(255, 255, 255, 0.70);
  border: 1px solid rgba(255, 255, 255, 0.92);
  border-radius: var(--radius-full);
  box-shadow: 0 15px 35px rgba(45, 65, 84, 0.16);
  backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
  overflow: hidden;
}
.nav {
  flex: 1 1 0; min-width: 0; max-width: 25%;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 3px; padding: 8px 3px 7px;
  border: 0; background: transparent;
  color: #71869a; border-radius: var(--radius-md);
  transition: var(--transition-base);
}
.nav i { font-style: normal; font-size: 20px; line-height: 1; }
.nav span { font-size: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.nav:hover { background: rgba(255, 255, 255, 0.5); }
.nav.active {
  background: linear-gradient(135deg, #ff4d86, #8d45e8);
  color: #fff; transform: translateY(-3px);
  box-shadow: 0 8px 18px rgba(141, 69, 232, 0.3);
}

/* ==============================
   WELCOME SECTION
   ============================== */
.welcome {
  padding: 24px 22px 20px; border-radius: var(--radius-xl) var(--radius-xl) 36px var(--radius-xl);
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  box-shadow: var(--shadow-glass); backdrop-filter: blur(22px); -webkit-backdrop-filter: blur(22px);
  color: var(--text-primary);
}
.label { font-size: 9px; letter-spacing: 3px; font-weight: 800; color: var(--accent-purple); text-transform: uppercase; }
.welcome h1 { font: 500 28px/1.15 var(--font-display); margin: 10px 0; color: var(--text-primary); }
.welcome h1 strong { font-weight: 600; }
.welcome p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; max-width: 480px; }
.pill, .outline { border-radius: var(--radius-full); padding: 12px 18px; font-weight: 700; font-size: 14px; transition: var(--transition-base); }
.pill {
  background: var(--accent-gradient); color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.18);
  box-shadow: 0 8px 22px rgba(139, 62, 232, 0.22);
}
.pill:hover { opacity: 0.92; transform: translateY(-1px); }
.welcome .pill { margin-top: 16px; }
.outline { background: rgba(255, 255, 255, 0.55); color: var(--text-primary); border: 1px solid var(--border-glass); }
.outline:hover { background: rgba(255, 255, 255, 0.75); }

/* --- Banner --- */
.banner {
  margin-top: 14px; height: 220px;
  border-radius: var(--radius-xl) var(--radius-xl) 36px var(--radius-xl);
  overflow: hidden; position: relative;
  background: #120b18; border: 1px solid rgba(255, 255, 255, 0.72);
}
.banner video { width: 100%; height: 100%; object-fit: cover; }
.banner::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 25%, rgba(20, 36, 52, 0.38)); pointer-events: none; }
.banner-overlay { position: absolute; z-index: 2; left: 18px; bottom: 16px; color: #fff; }
.banner-overlay span { display: block; font-size: 11px; letter-spacing: 2.5px; font-weight: 800; }
.banner-overlay small { display: block; font-size: 8px; letter-spacing: 2px; opacity: 0.8; }

/* --- Quick Actions --- */
.quick { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-top: 14px; }
.quick-card {
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  border-radius: var(--radius-lg); padding: 14px 12px;
  text-align: left; color: var(--text-primary); min-height: 80px;
  box-shadow: var(--shadow-sm); backdrop-filter: blur(12px);
  transition: var(--transition-base); display: flex; flex-direction: column;
}
.quick-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(47,68,91,.15); }
.quick-card i { font-style: normal; font-size: 22px; margin-bottom: 8px; color: #a08cc0; }
.quick-card b { font-size: 12px; font-weight: 600; }
.quick-card small { font-size: 8px; color: var(--text-muted); margin-top: 3px; }
.quick-card em { font-style: normal; font-size: 22px; color: #c9a8d8; margin-left: auto; margin-top: auto; }

/* --- Section Head --- */
.section-head {
  display: flex; align-items: flex-end; justify-content: space-between;
  margin: 22px 5px 12px; flex-wrap: wrap; gap: 8px;
}
.section-head h2 { font: 500 26px var(--font-display); margin: 4px 0 0; color: var(--text-primary); }
.section-head span { font-size: 10px; color: var(--text-muted); }
.section-head.top { margin-top: 26px; }

/* --- Chips / Category Filter --- */
.chips { display: flex; gap: 8px; overflow-x: auto; padding: 4px 2px 14px; scrollbar-width: thin; }
.chip {
  white-space: nowrap; border: 1px solid var(--border-glass);
  background: var(--bg-glass); color: var(--text-secondary);
  border-radius: var(--radius-full); padding: 10px 14px;
  font-size: 11px; font-weight: 600; transition: var(--transition-base);
}
.chip.active { background: var(--accent-gradient); color: #fff; border-color: rgba(255,255,255,.2); box-shadow: 0 7px 18px rgba(54,79,104,.10); }

/* ==============================
   PRODUCT GRID & CARDS
   ============================== */
.product-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }

.product-card {
  position: relative; overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.72);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(255, 245, 250, 0.55));
  backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
  box-shadow: 0 8px 28px rgba(90, 55, 70, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  border-radius: var(--radius-lg);
  transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  cursor: pointer;
}
.product-card::before {
  content: ""; position: absolute; top: 0; left: -120%; width: 70%; height: 100%;
  background: linear-gradient(105deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: skewX(-18deg); transition: left 0.55s ease; pointer-events: none; z-index: 2;
}
.product-card:hover { transform: translateY(-3px); border-color: rgba(255,255,255,.95); box-shadow: 0 14px 34px rgba(90,55,70,.15), inset 0 1px 0 rgba(255,255,255,1); }
.product-card:hover::before { left: 140%; }
.product-card:active { transform: scale(0.985); }
@media (hover: none) { .product-card:active::before { left: 140%; } }
.product-card > img { display: block; width: 100%; height: 155px; object-fit: cover; position: relative; z-index: 1; }
.product-placeholder {
  height: 155px; display: grid; place-items: center;
  background: linear-gradient(135deg, rgba(255, 63, 122, 0.16), rgba(139, 62, 232, 0.18));
  font-size: 50px; color: #e99bff;
}
.product-body { padding: 14px; position: relative; z-index: 3; }
.product-body small { font-size: 8px; letter-spacing: 1.5px; color: var(--text-secondary); font-weight: 800; text-transform: uppercase; }
.product-body h3 { font: 500 18px var(--font-display); margin: 6px 0; color: var(--text-primary); }
.product-body p { font-size: 11px; line-height: 1.5; color: var(--text-secondary); min-height: 30px; }
.product-body strong { display: block; font-size: 14px; margin: 9px 0 12px; color: var(--text-primary); }
.product-body .pill { padding: 10px 12px; font-size: 11px; width: 100%; cursor: pointer; }
.product-body .product-actions { display: grid; grid-template-columns: 1fr; gap: 8px; margin-top: 8px; }
.product-body .card-btn {
  width: 100%; padding: 12px 14px; border-radius: var(--radius-sm);
  border: 1px solid rgba(255,255,255,.95); background: rgba(255,255,255,.66);
  color: #38536c; font-weight: 700; font-size: 12px; cursor: pointer;
  box-shadow: 0 8px 18px rgba(54,79,104,.08); transition: var(--transition-base);
}
.product-body .card-btn:active { transform: scale(0.98); }
.product-body .card-btn:hover { background: rgba(255,255,255,.85); }
.wa-btn { background: linear-gradient(135deg, #21d46b, #10a957) !important; color: #fff !important; border-color: rgba(255,255,255,.65) !important; box-shadow: 0 8px 18px rgba(16,169,87,.18) !important; }

/* Empty State */
.empty-card {
  min-height: 230px; padding: 30px 22px;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  text-align: center; border-radius: var(--radius-xl) 22px var(--radius-xl) 22px;
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  box-shadow: var(--shadow-glass); backdrop-filter: blur(22px);
}
.empty-card.large { min-height: 400px; }
.empty-card h3 { font: 500 22px var(--font-display); margin: 3px 0 8px; }
.empty-card p { font-size: 12px; color: var(--text-secondary); line-height: 1.6; max-width: 430px; margin-bottom: 16px; }
.flower-mark { font-size: 48px; color: #e99bff; margin-bottom: 6px; }

/* ==============================
   PROFILE / TOKO PAGE
   ============================== */
.profile-card {
  display: flex; gap: 16px; align-items: center; padding: 22px;
  border-radius: var(--radius-xl) 22px var(--radius-xl) 22px;
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  box-shadow: var(--shadow-glass); backdrop-filter: blur(22px);
}
.profile-icon {
  width: 58px; height: 58px; display: grid; place-items: center;
  border-radius: 20px; background: linear-gradient(135deg, #ff3f7a, #843de0);
  font-size: 27px; box-shadow: 0 12px 25px rgba(132,61,224,0.25); flex-shrink: 0;
}
.profile-card h3 { font: 500 22px var(--font-display); margin: 0 0 5px; color: var(--text-primary); }
.profile-card p { font-size: 11px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

.store-info-card {
  margin-top: 12px; padding: 6px 15px; border-radius: var(--radius-lg);
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  box-shadow: var(--shadow-glass); backdrop-filter: blur(22px);
}
.store-info-row {
  display: flex; align-items: center; gap: 12px; padding: 12px 0;
  border-bottom: 1px solid var(--border-subtle);
}
.store-info-row:last-child { border-bottom: 0; }
.store-info-row > span {
  width: 34px; height: 34px; display: grid; place-items: center;
  border-radius: 12px; background: rgba(238, 245, 251, 0.75); font-size: 16px; flex-shrink: 0;
}
.store-info-row small { display: block; color: var(--text-secondary); font-size: 8px; letter-spacing: 1.4px; }
.store-info-row b { display: block; margin-top: 4px; color: var(--text-primary); font-size: 12px; }

.contact-card {
  margin-top: 12px; padding: 16px 18px; border-radius: var(--radius-md);
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  border: 1px solid var(--border-glass); background: var(--bg-glass);
  box-shadow: var(--shadow-glass); backdrop-filter: blur(22px);
}
.contact-card small { display: block; color: var(--text-secondary); font-size: 8px; letter-spacing: 1.5px; }
.contact-card b { display: block; margin-top: 4px; font-size: 12px; }
.contact-card .pill { padding: 10px 14px; font-size: 11px; }

.settings-list { margin-top: 12px; border-radius: var(--radius-lg); overflow: hidden; border: 1px solid var(--border-glass); background: var(--bg-glass); backdrop-filter: blur(22px); }
.settings-list button {
  width: 100%; display: flex; align-items: center; gap: 12px;
  text-align: left; padding: 16px 18px; border: 0;
  border-bottom: 1px solid rgba(72, 98, 122, 0.10);
  background: transparent; color: var(--text-primary); font-size: 15px;
  transition: var(--transition-base);
}
.settings-list button:hover { background: rgba(255,255,255,0.3); }
.settings-list button:last-child { border: 0; }
.settings-list span { font-size: 12px; flex: 1; }
.settings-list b { font-size: 20px; font-weight: 400; color: var(--text-secondary); }

/* ==============================
   PRAYER PAGE
   ============================== */
.prayer-card {
  padding: 22px; border: 1px solid rgba(70, 130, 180, 0.14); border-radius: var(--radius-lg);
  background: rgba(255, 255, 255, 0.72); box-shadow: 0 12px 35px rgba(40, 90, 130, 0.08);
  backdrop-filter: blur(22px);
}
.prayer-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; }
.prayer-top small, .prayer-next small { letter-spacing: .12em; font-weight: 800; opacity: .55; }
.prayer-top h3 { margin: 5px 0 2px; font-size: 22px; color: var(--text-primary); }
.prayer-top p { margin: 0; opacity: .6; font-size: 12px; color: var(--text-secondary); }
.prayer-icon { font-size: 38px; }
.prayer-select {
  width: 100%; box-sizing: border-box; padding: 14px 16px;
  border: 1px solid rgba(70, 130, 180, 0.18); border-radius: var(--radius-sm);
  background: #fff; font: inherit; margin-bottom: 14px; color: var(--text-primary);
}
.prayer-now {
  padding: 16px 18px; border-radius: var(--radius-md); background: rgba(255, 255, 255, 0.82);
  margin-bottom: 12px; border: 1px solid rgba(70, 130, 180, 0.12);
}
.prayer-now small { display: block; letter-spacing: .1em; font-weight: 800; opacity: .55; font-size: 9px; }
.prayer-now strong { display: block; font-size: 30px; margin-top: 5px; font-variant-numeric: tabular-nums; color: var(--text-primary); }
.prayer-next {
  padding: 18px; border-radius: var(--radius-md);
  background: linear-gradient(135deg, rgba(215, 238, 255, 0.9), rgba(255, 240, 247, 0.8));
  margin-bottom: 14px;
}
.prayer-next b { display: block; font-size: 18px; margin-top: 5px; color: var(--text-primary); }
.prayer-next strong { font-size: 32px; display: inline-block; margin-right: 10px; color: var(--text-primary); }
.prayer-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.prayer-item {
  display: flex; align-items: center; gap: 11px; padding: 14px;
  border-radius: var(--radius-sm); background: rgba(245, 249, 252, 0.9); border: 1px solid transparent;
  transition: var(--transition-base);
}
.prayer-item > span { font-size: 22px; }
.prayer-item small { display: block; opacity: .55; font-size: 9px; }
.prayer-item b { font-size: 18px; color: var(--text-primary); }
.prayer-item.next { border-color: rgba(80, 150, 200, 0.4); box-shadow: 0 5px 16px rgba(70, 130, 180, 0.09); }
.prayer-note { display: block; margin-top: 14px; opacity: .5; line-height: 1.5; font-size: 10px; color: var(--text-muted); }

/* ==============================
   OWNER PAGE
   ============================== */
.owner-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; padding: 12px; border-radius: var(--radius-lg); background: var(--bg-glass); border: 1px solid var(--border-glass); }
.owner-stats div { text-align: center; padding: 8px; }
.owner-stats small { display: block; color: var(--text-muted); font-size: 9px; }
.owner-stats b { font-size: 22px; color: var(--text-primary); }

.visitor-card {
  margin-bottom: 12px; padding: 18px; border-radius: var(--radius-lg);
  background: linear-gradient(145deg, rgba(35, 16, 52, 0.08), rgba(17, 10, 26, 0.06));
  border-color: rgba(151, 74, 223, 0.22); backdrop-filter: blur(22px);
}
.visitor-top { display: flex; align-items: center; gap: 11px; padding: 3px 2px 14px; }
.visitor-avatar { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 18px; background: linear-gradient(135deg, #7131d9, #a04bff); font-size: 20px; box-shadow: 0 0 25px rgba(130, 55, 230, 0.32); flex-shrink: 0; }
.visitor-title { flex: 1; }
.visitor-title small { font-size: 8px; letter-spacing: 2px; color: var(--text-secondary); font-weight: 800; }
.visitor-title h3 { font-size: 17px; margin: 4px 0 0; color: var(--text-primary); }
.online-dot { font-size: 10px; color: #1f9d5b; white-space: nowrap; }
