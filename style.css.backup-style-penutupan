/* ==============================
    TOAST
   ============================== */
.toast {
  position: fixed; bottom: 130px; left: 50%; transform: translateX(-50%) translateY(20px);
  background: #fff; color: #263b50; padding: 10px 20px; border-radius: 999px;
  font-size: 13px; font-weight: 600; box-shadow: 0 8px 25px rgba(0,0,0,0.15);
  opacity: 0; transition: opacity 0.3s ease, transform 0.3s ease; z-index: 9999;
  pointer-events: none; white-space: nowrap;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* ==============================
   LOADER
   ============================== */
#loader {
  position: fixed; inset: 0; z-index: 99; background: var(--bg-primary);
  display: flex; align-items: center; justify-content: center;
  transition: opacity 0.5s ease;
}
#loader.hide { opacity: 0; pointer-events: none; }
