.catalog-search {
  display: flex; align-items: center; gap: 8px; margin: 12px 0; padding: 0 12px;
  background: #fff; border: 1px solid rgba(237, 221, 227, 0.8); border-radius: var(--radius-md);
}
.catalog-search input { flex: 1; border: 0; outline: 0; padding: 13px 4px; background: transparent; font-size: 14px; color: var(--text-primary); }
.catalog-search button { border: 0; background: none; font-size: 20px; color: #999; cursor: pointer; }

/* Search Empty State */
.search-empty { text-align: center; padding: 40px 20px; color: var(--text-secondary); }
.search-empty { font-size: 14px; }

/* Owner Login Modal */
.owner-login-modal {
  position: fixed; inset: 0; z-index: 9999;
  display: grid; place-items: center; padding: 20px;
  background: rgba(0, 0, 0, 0.55); backdrop-filter: blur(10px);
}
.owner-login-modal[hidden] {
  display: none !important;
}

/* Promo Price */
.promo-price { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.price-old { text-decoration: line-through; color: var(--text-muted); font-size: 13px; }

/* ==============================
   GAME STYLES
   ============================== */
.flower-game {
  background: rgba(255, 255, 255, 0.85);
  border-radius: var(--radius-xl);
  padding: 18px;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.08);
}
.game-top { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 15px; }
.game-top div { flex: 1; text-align: center; background: #f8f8f8; border-radius: 15px; padding: 10px; }
.game-top small { display: block; color: #888; font-size: 10px; }
.game-top strong { display: block; font-size: 22px; margin-top: 3px; }
.game-area {
  position: relative; height: 330px; overflow: hidden;
  border-radius: var(--radius-lg);
  background: linear-gradient(180deg, #f7fcff, #fff5fa);
  border: 2px solid #eee; margin-bottom: 15px;
}
.game-start-text {
  position: absolute; inset: 0;
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  text-align: center; font-size: 45px;
}
.game-start-text b { font-size: 20px; color: #444; margin-top: 8px; }
.game-start-text small { font-size: 13px; color: #777; margin-top: 5px; }
.game-flower {
  position: absolute; border: 0; background: transparent;
  font-size: 42px; padding: 5px; cursor: pointer;
  user-select: none; -webkit-tap-highlight-color: transparent;
  animation: rvFlowerPop 0.18s ease;
}
@keyframes rvFlowerPop {
  from { transform: scale(0.4); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}
.game-message { text-align: center; color: #777; font-size: 13px; margin: 12px 0 0; }

/* ==============================
   PRINT & ACCESSIBILITY
   ============================== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: 0.01ms !important; transition-duration: 0.01ms !important; }
}

/* Scrollbar styling */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb { background: rgba(120, 90, 110, 0.2); border-radius: 99px; }
::-webkit-scrollbar-thumb:hover { background: rgba(120, 90, 110, 0.35); }

/* ==============================
    THEME SYSTEM
    ============================== */

/* --- Theme Transitions --- */
body, .shell, .header, .bottom, .welcome, .quick-card,
.product-card, .owner-card, .prayer-card, .profile-card,
.store-info-card, .contact-card, .settings-list,
.visitor-card, .music-player, .music-btn, .pill,
.chip, .analytics-box, .label, .game-area,
#siteBackground, #siteBackgroundShade,
.pd-box, .card-dialog, .custom-dialog,
.toast, #loader {
  transition: background-color 0.6s ease, border-color 0.6s ease,
              box-shadow 0.6s ease, color 0.6s ease,
              backdrop-filter 0.6s ease;
}

