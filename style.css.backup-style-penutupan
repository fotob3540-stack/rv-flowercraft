  display: block !important;
  min-height: calc(100vh - 150px) !important;
  height: auto !important;
  overflow: visible !important;
}

/* Jangan membuat seluruh halaman AI menjadi area scroll sendiri */
#ai .ai-messages,
#ai .skybot-messages {
  position: relative !important;
  height: auto !important;
  max-height: none !important;
  overflow: visible !important;
  flex: none !important;
}

/* Composer SkyBot */
#ai .skybot-input-area,
#ai .skybot-composer {
  position: sticky !important;
  bottom: 85px !important;
  z-index: 50 !important;
  width: 100% !important;
  margin: 20px auto !important;
  box-sizing: border-box !important;
}

/* Isi composer tetap satu baris */
#ai .skybot-input-area {
  display: flex !important;
  align-items: center !important;
}

/* Input jangan melebar/terlempar */
#ai #skybotInput,
#ai #aiInput {
  flex: 1 !important;
  min-width: 0 !important;
  box-sizing: border-box !important;
}

/* Tombol tetap di tempat */
#ai #skybotPlus,
#ai #skybotMic,
#ai #skybotSend,
#ai #aiSend {
  flex-shrink: 0 !important;
}

/* Hilangkan scroll horizontal */
#ai,
#ai * {
  max-width: 100%;
}

#ai {
  overflow-x: hidden !important;
}

/* Jangan sampai footer/catatan menggandakan posisi */
#ai .ai-disclaimer {
  position: relative !important;
}

/* Tampilan sederhana */
#ai .skybot-input-area,
#ai .skybot-composer {
  background: rgba(255,255,255,.96) !important;
  border-radius: 24px !important;
  box-shadow: 0 5px 20px rgba(0,0,0,.08) !important;
}



/* ===== RV FLOWERCRAFT PENUTUPAN SEMENTARA ===== */
.temporary-closure{
  position:fixed;
  inset:0;
  z-index:999999999;
  background:#fff;
  color:#000;
  overflow:auto;
  display:flex;
  justify-content:center;
  align-items:flex-start;
  padding:7vh 20px 90px;
  box-sizing:border-box;
  font-family:Arial,Helvetica,sans-serif;
}

.closure-box{
  width:min(780px,100%);
  text-align:center;
}

.closure-box h1{
  margin:0 0 45px;
  font-size:clamp(42px,8vw,88px);
  line-height:.98;
  font-weight:900;
  letter-spacing:-3px;
}

#closureMessage{
  width:100%;
  height:min(58vh,680px);
  min-height:330px;
  box-sizing:border-box;
  resize:vertical;
  border:7px solid #000;
  border-radius:0;
  outline:none;
  padding:25px;
  background:#fff;
  color:#000;
  font-size:20px;
  font-family:Arial,Helvetica,sans-serif;
}

#closureMessage:focus{
  box-shadow:0 0 0 3px #ddd;
}

#closureSend{
  width:100%;
  margin-top:20px;
  padding:18px;
  border:3px solid #000;
  background:#000;
  color:#fff;
  font-size:18px;
  font-weight:900;
  cursor:pointer;
}

#closureView{
  position:fixed;
  right:25px;
  bottom:15px;
  border:0;
  background:transparent;
  color:#000;
  font-size:18px;
  cursor:pointer;
}

.closure-modal{
  position:fixed;
  inset:0;
  z-index:1000000000;
  display:none;
  align-items:center;
  justify-content:center;
  padding:20px;
  background:rgba(0,0,0,.65);
}

.closure-modal.show{
  display:flex;
}

.closure-modal-box{
  position:relative;
  width:min(430px,100%);
  max-height:85vh;
  overflow:auto;
  box-sizing:border-box;
  background:#fff;
  color:#000;
  border:3px solid #000;
  padding:30px;
  text-align:center;
}

.closure-modal-box h2{
  margin:0 0 20px;
}

#closureLoginClose,
#closureInboxClose{
  position:absolute;
  top:5px;
  right:10px;
  border:0;
  background:none;
  font-size:32px;
  cursor:pointer;
}

#closurePassword{
  width:100%;
  box-sizing:border-box;
  padding:14px;
  border:2px solid #000;
  font-size:18px;
  margin-bottom:12px;
}

#closureUnlock,
#closureClear{
  width:100%;
  padding:14px;
  border:2px solid #000;
  background:#000;
  color:#fff;
  font-weight:900;
  cursor:pointer;
}

#closureError{
  color:#c00;
  min-height:20px;
}

.closure-message{
  border:2px solid #000;
  padding:15px;
  margin:12px 0;
  text-align:left;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
}

.closure-date{
  font-size:12px;
  opacity:.55;
  margin-bottom:8px;
}

@media(max-width:600px){
  .closure-box h1{
    font-size:clamp(34px,11vw,60px);
    letter-spacing:-2px;
    margin-bottom:30px;
  }

  #closureMessage{
    min-height:300px;
    border-width:5px;
    font-size:17px;
  }

  #closureView{
    right:18px;
    bottom:10px;
    font-size:16px;
  }
}


