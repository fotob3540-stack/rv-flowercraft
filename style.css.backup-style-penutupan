/* ==============================
    PARTICLES - DARK CINEMATIC
    ============================== */
body.theme-dark #particles-container {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
}

.cinematic-particle {
  position: absolute;
  border-radius: 50%;
  background: rgba(200, 200, 220, 0.15);
  pointer-events: none;
  will-change: transform, opacity;
  animation: cinematicFloat linear infinite;
}

.cinematic-particle.size-tiny { width: 2px; height: 2px; }
.cinematic-particle.size-small { width: 3px; height: 3px; }
.cinematic-particle.size-medium { width: 4px; height: 4px; }

@keyframes cinematicFloat {
  0% {
    transform: translateY(100vh) translateX(0);
    opacity: 0;
  }
  5% {
    opacity: 0.15;
  }
  90% {
    opacity: 0.15;
  }
  100% {
    transform: translateY(-10vh) translateX(30px);
    opacity: 0;
  }
}

/* Alternative particle type - small lines */
.cinematic-line {
  position: absolute;
  background: rgba(200, 200, 220, 0.08);
  pointer-events: none;
  will-change: transform, opacity;
  animation: cinematicLineFlow linear infinite;
}

@keyframes cinematicLineFlow {
  0% {
    transform: translateY(100vh) translateX(0) scaleY(0);
    opacity: 0;
  }
  5% {
    opacity: 0.1;
    transform: translateY(100vh) translateX(0) scaleY(1);
  }
  90% {
    opacity: 0.1;
    transform: translateY(-10vh) translateX(20px) scaleY(1);
  }
  100% {
    transform: translateY(-10vh) translateX(20px) scaleY(0);
    opacity: 0;
  }
}

/* Theme transition helper */
.theme-transition,
.theme-transition *,
.theme-transition *::before,
.theme-transition *::after {
  transition: background-color 0.6s ease, border-color 0.6s ease,
              box-shadow 0.6s ease, color 0.6s ease,
              backdrop-filter 0.6s ease, background-image 0.6s ease !important;
}

/* ==============================
    PRINT & ACCESSIBILITY (theme-safe)
    ============================== */
@media (prefers-reduced-motion: reduce) {
  .cinematic-particle, .cinematic-line { animation: none !important; display: none; }
}

