/* RV_FLOWERCRAFT_NATURAL_CLOSURE_START */

#temporaryClosure.rv-natural-closure {
  position: fixed;
  inset: 0;
  z-index: 999999;
  display: none;
  overflow: hidden;
  background:
    linear-gradient(
      180deg,
      #dceee8 0%,
      #eef5ef 46%,
      #d7e2d6 72%,
      #8fa48e 100%
    );
  color: #334338;
  font-family:
    Inter,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  isolation: isolate;
}

#temporaryClosure.rv-natural-closure.rv-show {
  display: flex;
  align-items: center;
  justify-content: center;
}

.rv-nature-sky {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
}

.rv-cloud {
  position: absolute;
  width: 180px;
  height: 48px;
  border-radius: 60px;
  background: rgba(255,255,255,.46);
  filter: blur(1px);
  opacity: .7;
}

.rv-cloud::before,
.rv-cloud::after {
  content: "";
  position: absolute;
  border-radius: 50%;
  background: rgba(255,255,255,.52);
}

.rv-cloud::before {
  width: 75px;
  height: 75px;
  left: 28px;
  bottom: 5px;
}

.rv-cloud::after {
  width: 58px;
  height: 58px;
  right: 28px;
  bottom: 0;
}

.rv-cloud-1 {
  top: 11%;
  left: -220px;
  animation: rvCloudMove 42s linear infinite;
}

.rv-cloud-2 {
  top: 25%;
  left: -260px;
  transform: scale(.72);
  animation: rvCloudMove 55s linear infinite 8s;
}

.rv-cloud-3 {
  top: 8%;
  left: -300px;
  transform: scale(.55);
  opacity: .4;
  animation: rvCloudMove 65s linear infinite 18s;
}

@keyframes rvCloudMove {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(calc(100vw + 600px));
  }
}

.rv-nature-light {
  position: absolute;
  width: 420px;
  height: 420px;
  top: -190px;
  right: -130px;
  border-radius: 50%;
  background: rgba(255,247,210,.32);
  filter: blur(20px);
}

.rv-closure-card {
