/* ==============================
    STARS - STARRY NIGHT EFFECT
    ============================== */

#star-container {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  overflow: hidden;
  display: none;
}

#star-container.visible {
  display: block;
}

.star {
  position: absolute;
  border-radius: 50%;
  background: #ffffff;
  pointer-events: none;
  will-change: transform, opacity;
}

.star.size-xs { width: 1px; height: 1px; }
.star.size-sm { width: 2px; height: 2px; }
.star.size-md { width: 3px; height: 3px; }
.star.size-lg { width: 4px; height: 4px; }

.star.twinkle {
  animation: starTwinkle ease-in-out infinite;
}

@keyframes starTwinkle {
  0%, 100% { opacity: 0.15; transform: scale(0.8); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

.star.twinkle-slow {
  animation: starTwinkleSlow ease-in-out infinite;
}

@keyframes starTwinkleSlow {
  0%, 100% { opacity: 0.1; transform: scale(0.9); }
  50% { opacity: 0.6; transform: scale(1.1); }
}

.star.twinkle-fast {
  animation: starTwinkleFast ease-in-out infinite;
}

@keyframes starTwinkleFast {
  0%, 100% { opacity: 0.2; transform: scale(0.85); }
  50% { opacity: 0.9; transform: scale(1.15); }
}

/* Theme transition for starry night */
body.theme-starry-night,
body.theme-starry-night *,
body.theme-starry-night *::before,
body.theme-starry-night *::after {
  transition: background-color 0.6s ease, border-color 0.6s ease,
              box-shadow 0.6s ease, color 0.6s ease,
              backdrop-filter 0.6s ease, background-image 0.6s ease !important;
}

/* ==============================
    PRINT & ACCESSIBILITY (theme-safe)
    ============================== */
@media (prefers-reduced-motion: reduce) {
  .cinematic-particle, .cinematic-line { animation: none !important; display: none; }
  .star.twinkle, .star.twinkle-slow, .star.twinkle-fast { animation: none !important; opacity: 0.4; }
}

